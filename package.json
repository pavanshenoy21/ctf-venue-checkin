{
  "name": "ctf-venue-checkin-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/scripts/cli.ts",
    "test:e2e": "next build && playwright test",
    "build:cli": "esbuild src/scripts/cli.ts --bundle --platform=node --target=node22 --format=cjs --external:pg-native --outfile=dist/cli.cjs --log-level=warning"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "csv-parse": "7.0.3",
    "get-nonce": "1.0.1",
    "jszip": "3.10.2",
    "lucide-react": "1.63.0",
    "next": "16.4.1",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "mailparser": "3.9.39",
    "pngjs": "7.0.0",
    "shadcn": "4.23.0",
    "smtp-server": "3.19.22",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
