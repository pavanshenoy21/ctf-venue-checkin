# Copy to .env and edit. Never commit .env.

# --- database ---------------------------------------------------------------------------------
POSTGRES_USER=ctf
POSTGRES_DB=ctf
# URL-safe characters only (it is placed inside a connection URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-24

# --- public address ---------------------------------------------------------------------------
# The HTTPS address participants open. It is baked into every QR code and email, so set it before
# generating them. No trailing slash. Phone cameras only work on https:// pages.
PUBLIC_BASE_URL=https://ctf.example.edu
# Only for the bundled Caddy (docker compose --profile https): the host name from PUBLIC_BASE_URL.
DOMAIN=ctf.example.edu

# Port the app listens on, on 127.0.0.1 only (your reverse proxy forwards to it).
HTTP_PORT=3000
# Set to false ONLY when testing over plain http://localhost
COOKIE_SECURE=true
# Number of reverse proxies in front of the app that append to X-Forwarded-For (Caddy alone = 1;
# Cloudflare -> Caddy = 2).
PROXY_HOPS=1

# --- event --------------------------------------------------------------------------------------
EVENT_NAME=Voyage to Ithaca
EVENT_TZ=Asia/Kolkata
SESSION_HOURS=12
DTH_CAPACITY=145
ISE_CAPACITY=113
# Team-column values that mean "no team" (case-insensitive; a blank cell always means no team)
NO_TEAM_MARKERS=(no team),no team,none,n/a,-,solo

# --- rate limits (per minute) -----------------------------------------------------------------------
RATE_LOGIN_PER_MIN=10
RATE_PUBLIC_PER_MIN=600
RATE_PUBLIC_INVALID_PER_MIN=30
RATE_CHECKIN_PER_MIN=300

# --- email (optional; without it use the mail-merge CSV export) ---------------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# pause between messages, for providers with strict per-second limits
SMTP_DELAY_MS=0
